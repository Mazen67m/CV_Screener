# ==============================================================================
# Git Ignore Configuration
# Project: CV Screener (.NET 8 + Next.js 14 + ML / Python)
# ==============================================================================

# ── Next.js / Frontend / Node ────────────────────────────────────────────────
node_modules/
**/node_modules/
frontend/.next/
**/.next/
frontend/out/
**/out/
frontend/build/
**/build/
frontend/dist/
**/dist/

# TypeScript & Build Caches
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo
.turbo/
.vercel/

# Package Manager Logs & Artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ── .NET / C# ────────────────────────────────────────────────────────────────
**/[Bb]in/
**/[Oo]bj/
**/[Aa]rtifacts/
**/[Pp]ublish/

# Visual Studio & Rider
.vs/
.idea/
*.user
*.suo
*.userprefs
*.userosscache
*.sln.docstates
*.slnx.sqlite
*.ncrunch*
*.DotSettings.user

# NuGet & Publish Artifacts
*.nupkg
backend/**/packages/
!backend/**/.nuget/packages/.gitignore
backend/**/project.lock.json
backend/**/project.fragment.lock.json
backend/**/*.PublishSettings

# ── Python / Machine Learning ────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual Environments
.venv/
venv/
env/
ENV/
ml/.venv/
ml/venv/
ml/env/

# Python Build / Distribution
ml/*.egg-info/
ml/dist/
ml/build/
ml/.eggs/
*.egg-info/

# Jupyter Notebooks
.ipynb_checkpoints/

# ML Generated Models & Large Corpora (Runtime / Training outputs)
ml/data/
ml/tmp_check/
ml/corpus.json
ml/models/*.onnx
ml/models/*.pkl
ml/models/*.joblib
ml/models/vocabulary.json
ml/models/idf_weights.json

# Keep taxonomy file tracked
!ml/skills_taxonomy.json

# ── Testing & Code Coverage ──────────────────────────────────────────────────
coverage/
**/coverage/
.nyc_output/
.pytest_cache/
.coverage
htmlcov/
playwright-report/
test-results/
blob-report/

# ── Secrets & Environment Variables ──────────────────────────────────────────
# Ignore all .env files EXCEPT example templates
.env
.env.*
*.env
*.env.*
!.env.example
!.env.*.example
!.env.local.example

# Frontend Local Env Files
frontend/.env.local
frontend/.env*.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Backend Secret Envs
backend/**/.env
backend/**/.env.*

# Certificates & Private Keys
*.pem
*.key
*.crt
*.pfx
*.p12
*.cer

# ── Docker & Local Overrides ─────────────────────────────────────────────────
docker-compose.override.yml
*.local.yml
*.local.yaml

# ── Agent / IDE / Tooling Artifacts ──────────────────────────────────────────
.agents/
.impeccable/
.gemini/
.cursor/
.claude/
skills-lock.json

# VS Code settings customization (allow sharing essential settings)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── Operating System ─────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Logs & Temporary Files ───────────────────────────────────────────────────
*.log
logs/
tmp/
temp/
*.tmp

# ── User Uploads & Runtime Blobs ─────────────────────────────────────────────
uploads/
**/uploads/
*.pdf

